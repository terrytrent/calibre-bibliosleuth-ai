# Virtual environments
.venv/
venv/
env/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.hypothesis/
.tox/
.nox/

# Coverage and test reports
.coverage
.coverage.*
coverage.xml
htmlcov/
junit.xml

# Generated build output and dependency caches
build/
dist/
*.egg-info/

# Qlty-generated state. Keep its project configuration under version control.
.qlty/*
!.qlty/.gitignore
!.qlty/qlty.toml

# Editors and operating systems
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
